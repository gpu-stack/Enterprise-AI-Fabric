# =======================================================
# Enterprise-RAG-V2 Environment Blueprint
# =======================================================

# --- AI INFRASTRUCTURE ENDPOINTS (Decoupled Services) ---
# If AI Infra runs on same host via docker-compose.infra.yml, use host.docker.internal or localhost
QDRANT_HOST=host.docker.internal
QDRANT_PORT=6333
EMBEDDING_SERVER_URL=http://host.docker.internal:8090
RERANKER_SERVER_URL=http://host.docker.internal:8081

# --- LLM INFERENCE ENGINE CONFIG ---
# Options: CLOUD or ON_PREM (vLLM / Ollama / NIM)
LLM_DEPLOYMENT_MODE=CLOUD
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_api_key_here
DEFAULT_MODEL_ID=meta/llama-3.1-8b-instruct

# --- RERANKER SETTINGS ---
RERANK_ENABLED=True
RERANKER_SCORE_THRESHOLD=0.40
VECTOR_TOP_K=20
RERANK_TOP_K=3

# --- CHUNKING PARAMETERS ---
CHUNK_MAX_SIZE=1200
CHUNK_OVERLAP=200